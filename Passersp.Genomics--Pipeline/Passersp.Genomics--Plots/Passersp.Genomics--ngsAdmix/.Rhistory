final_plot <- top_row / ngsAdmix +
plot_layout(heights = c(3, 1)) +
plot_annotation(
tag_levels = 'A',       # creates A, B, ...
tag_prefix = "",        # just "A" instead of "(A)"
tag_suffix = ")",       # add closing parenthesis
theme = theme(
plot.tag = element_text(
size = 20, fontface = "bold", family = "Optima",
hjust = 0, vjust = 1      # aligns top-left of each plot
)
)
)
# Adds labels to the panel  ~
final_plot <- top_row / ngsAdmix +
plot_layout(heights = c(3, 1)) +
plot_annotation(
tag_levels = 'A',       # creates A, B, ...
tag_prefix = "",        # just "A" instead of "(A)"
tag_suffix = ")",       # add closing parenthesis
theme = theme(
plot.tag = element_text(
size = 20, face = "bold", family = "Optima",
hjust = 0, vjust = 1      # aligns top-left of each plot
)
)
)
# Saves the final plot ~
ggsave(final_plot, file = "Oi.pdf",
device = cairo_pdf, width = 25, height = 20, scale = 1, dpi = 600)
# Adds labels to the panel  ~
final_plot <- combined_plot +
inset_element(
p = textGrob("A)", x = 0, y = 1, just = c("left", "top"),
gp = gpar(fontface = "bold", fontsize = 20, fontfamily = "Optima")),
left = 0, right = 1, top = 1, bottom = 0.67   # top panel roughly occupies 2/3 of height
) +
inset_element(
p = textGrob("B)", x = 0, y = 1, just = c("left", "top"),
gp = gpar(fontface = "bold", fontsize = 20, fontfamily = "Optima")),
left = 0, right = 1, top = 0.67, bottom = 0   # bottom panel roughly occupies 1/3 of height
)
# Saves the final plot ~
ggsave(final_plot, file = "Oi.pdf",
device = cairo_pdf, width = 25, height = 20, scale = 1, dpi = 600)
PCA_Plot <- PCA_Plot +
annotate(
"text", x = -Inf, y = Inf, label = "A)",
hjust = -0.1, vjust = 1.1,
size = 6, fontface = "bold", family = "Optima"
)
# Example for ngsAdmix
ngsAdmix <- ngsAdmix +
annotate(
"text", x = -Inf, y = Inf, label = "B)",
hjust = -0.1, vjust = 1.1,
size = 6, fontface = "bold", family = "Optima"
)
# Creates Population Structure panel  ~
top_row <- plot_spacer() + PCA_Plot + plot_spacer() + plot_layout(widths = c(1, 4, 1))
combined_plot <- top_row / ngsAdmix + plot_layout(heights = c(3, 1))
# Saves the final plot ~
ggsave(final_plot, file = "Oi.pdf",
device = cairo_pdf, width = 25, height = 20, scale = 1, dpi = 600)
# Saves the final plot ~
ggsave(combined_plot, file = "Oi.pdf",
device = cairo_pdf, width = 25, height = 20, scale = 1, dpi = 600)
top_row <- plot_spacer() + PCA_Plot + plot_spacer() + plot_layout(widths = c(1, 4, 1))
combined_plot <- top_row / ngsAdmix + plot_layout(heights = c(3, 1))
combined_plot <- combined_plot +
annotate("text", x = -Inf, y = Inf, label = "A)",
hjust = -.1, vjust = 1.1,
size = 6, fontface = "bold", family = "Optima")
# Saves the final plot ~
ggsave(combined_plot, file = "Oi.pdf",
device = cairo_pdf, width = 25, height = 20, scale = 1, dpi = 600)
# Creates Population Structure panel  ~
