pdf2_img <- image_read_pdf("Passersp.Genomics--ngsAdmix_Abridged.pdf", density = 300)
# Combine vertically
combined_img <- image_append(c(pdf1_img, pdf2_img), stack = TRUE)
# Add labels (optional)
combined_img <- combined_img %>%
image_annotate("A)", size = 40, weight = 700,
location = "+20+30", color = "black") %>%
image_annotate("B)", size = 40, weight = 700,
location = "+20+30", color = "black")
image_write(combined_img, "combined_output.pdf", format = "pdf")
pdf_combine(c("Passersp.Genomics--PCA.pdf", "Passersp.Genomics--ngsAdmix_Abridged.pdf"),
output = "combined_multipage.pdf")
# Read PDFs with high resolution
pdf1 <- image_read_pdf("Passersp.Genomics--PCA.pdf", density = 300)
pdf2 <- image_read_pdf("Passersp.Genomics--ngsAdmix_Abridged.pdf", density = 300)
# Resize if needed (optional)
pdf1 <- image_scale(pdf1, "1000x")
pdf2 <- image_scale(pdf2, "1000x")
# Stack vertically
combined <- image_append(c(pdf1, pdf2), stack = TRUE)
# Save as single-page PDF
image_write(combined, "combined_panel.pdf", format = "pdf")
