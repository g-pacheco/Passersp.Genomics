family = "Optima", size = 3.8, fontface = "bold", max.overlaps = 100, nudge_x = .15, nudge_y = 0,
point.padding = 1, force_pull = 10, segment.size = .3, colour = "black", fill = "#d9d9d9", alpha = .85,
