hits <- findOverlaps(HouseGenes, intervals_gr)
genes_in_intervals <- HouseGenes[queryHits(hits)]
GenesWithinAIMs <- data.frame(GeneID = mcols(genes_in_intervals)$Name,
CHR = as.character(seqnames(genes_in_intervals)),
