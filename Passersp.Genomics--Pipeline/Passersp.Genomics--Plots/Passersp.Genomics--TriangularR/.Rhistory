dt <- as.data.table(fulldf)
# For each chromosome, do everything inside a nested operation
result <- dt[, {
temp <- .SD
temp[, run_id := rleid(Ancestry)]
ancestry_2_runs <- temp[Ancestry == 2]
if (nrow(ancestry_2_runs) == 0) return(NULL)
longest_run <- ancestry_2_runs[, .N, by = run_id][which.max(N), run_id]
ancestry_2_runs[run_id == longest_run]
}, by = CHR]
# Convert to data.table for run-length encoding
dt <- as.data.table(fulldf)
# For each chromosome, do everything inside a nested operation
result <- dt[, {
temp <- copy(.SD)                        # Safe to modify
temp[, run_id := rleid(Ancestry)]       # Assign contiguous run IDs
ancestry_2_runs <- temp[Ancestry == 2]
if (nrow(ancestry_2_runs) == 0) return(NULL)
# Find the longest block of Ancestry == 2
longest_run <- ancestry_2_runs[, .N, by = run_id][which.max(N), run_id]
ancestry_2_runs[run_id == longest_run]
}, by = CHR]
# For each chromosome, do everything inside a nested operation
result <- dt[, {
temp <- copy(.SD)                        # Safe to modify
temp[, run_id := rleid(Ancestry)]       # Assign contiguous run IDs
