arrow = arrow(angle = 30, length = unit(.10, "inches"),
ends = "last", type = "open")) +
scale_x_continuous("Hybird Index",
breaks = c(.25, .5, .75),
labels = c("0.25", "0.50", "0.75"),
limits = c(0, 1),
expand = c(.01, .01)) +
