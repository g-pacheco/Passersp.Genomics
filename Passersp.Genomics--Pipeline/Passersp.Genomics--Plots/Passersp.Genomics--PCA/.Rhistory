# Converts from NWK into NEXUS ~
tree <- read.tree("Y150239Genomics_mtGenome.Phylogeny.ML.treefile")
# Convert tree to Newick string
tree_string <- write.tree(tree)
tree_stripped <- gsub(":[0-9.eE+-]+", "", tree_string)
tree_stripped <- gsub("\\)([0-9.eE+-]+)", ")", tree_stripped)
for (i in seq_len(nrow(conversion))) {
old <- conversion$OldName[i]
new <- conversion$NewName[i]
tree_stripped <- gsub(paste0("\\b", old, "\\b"), new, tree_stripped)
}
write(tree_stripped, file = "Y150239Genomics_mtGenome.Phylogeny.ML.Renamed.treefile")
